[Unit]
Description=Ervisio Minecraft server manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ervisio-minecraft
Group=ervisio-minecraft
RuntimeDirectory=ervisio-minecraft
RuntimeDirectoryMode=0750
WorkingDirectory=/srv/ervisio/minecraft
ExecStart=/usr/bin/python3 /usr/lib/ervisio-minecraft/minecraft_runtime.py --socket /run/ervisio-minecraft/control.sock --data /srv/ervisio/minecraft
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=mixed
UMask=0007
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/ervisio/minecraft /run/ervisio-minecraft
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
