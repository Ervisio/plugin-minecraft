{
  "name": "ervisio-plugin-minecraft",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc --noEmit && vite build && ervisio-plugin-pack copy",
    "dev": "ervisio-plugin-pack copy && vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v",
    "pack": "ervisio-plugin-pack pack",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@ervisio/plugin-sdk": "github:Ervisio/plugin-sdk#v0.1.0",
    "@types/react": "^18.3.31",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  }
}
